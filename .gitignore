.sentryclirc
sentry.properties

# Logs / debug
# Logs de build Gradle : volumineux, regenerables, et un log committe par
# accident finit par embarquer des chemins locaux.
*-build.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS / IDE
.DS_Store
*.pem
.idea/
.vscode/


# Google Play service account (eas submit) - SECRET, ne jamais committer
play-service-account.json

# Photos produits téléchargées par erreur à la racine (résolution codes-barres).
# Elles vont dans Supabase Storage, jamais dans le repo. Le nom = un EAN
# (commence par un chiffre) → on ne touche pas aux vrais assets (logoCC.png…).
/[0-9]*.jpg
/[0-9]*.jpeg
/[0-9]*.png
/[0-9]*.webp

# Clés de compte de service Firebase/Google (SECRET, ne jamais committer)
*-firebase-adminsdk-*.json
service-account*.json
google-service-account*.json
fcm-*.json
# Clé APNs iOS (SECRET)
*.p8
scripts/.backfill_checkpoint.json

# Export catalogue : fichier de donnees volumineux (~348 Mo), regenerable via
# les scripts d'export. Depasse la limite GitHub (100 Mo) -> jamais dans le repo.
/catalog.csv

# Clés Apple/Google : jamais dans l'historique. Le dossier entier, pas seulement
# les extensions connues — une clé oubliée sous un nom inattendu coûte une rotation.
secrets/

